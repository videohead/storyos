{
  "templates": [
    {
      "template_id": "character-sheet",
      "version": "1.0",
      "label": "Character Sheet",
      "description": "Generate a consistent character reference sheet from story context and a prompt.",
      "structure": {
        "structure_id": "text_to_image",
        "version": "1.0"
      },
      "provider_type": null,
      "configuration": {
        "parameters": {
          "prompt": "Character reference sheet, full body, neutral pose, plain background",
          "negative_prompt": "extra limbs, watermark, text"
        },
        "scf_fields": {
          "prompt": "positive_prompt",
          "negative_prompt": "negative_prompt"
        }
      },
      "defaults": {
        "output_count": 1
      },
      "status": "active",
      "tags": ["character", "reference"]
    },
    {
      "template_id": "scene-still",
      "version": "1.0",
      "label": "Scene Still",
      "description": "Generate a still image of a scene from its description and location context.",
      "structure": {
        "structure_id": "text_to_image"
      },
      "provider_type": null,
      "configuration": {
        "parameters": {
          "prompt": "Cinematic still of the scene, consistent lighting and palette"
        },
        "scf_fields": {
          "prompt": "summary"
        }
      },
      "defaults": {
        "output_count": 1
      },
      "status": "active",
      "tags": ["scene", "still"]
    },
    {
      "template_id": "storyboard-frame",
      "version": "1.0",
      "label": "Storyboard Frame",
      "description": "Animate a storyboard frame image into a short video take.",
      "structure": {
        "structure_id": "image_to_video",
        "version": "1.0"
      },
      "provider_type": null,
      "configuration": {
        "parameters": {
          "prompt": "Subtle motion following the frame description",
          "duration_seconds": 5,
          "aspect_ratio": "16:9"
        },
        "references": [
          {
            "role": "content",
            "source": "scf_field",
            "scf_field": "image_asset",
            "required": true
          }
        ],
        "scf_fields": {
          "prompt": "frame_description"
        }
      },
      "defaults": {
        "output_count": 1
      },
      "status": "active",
      "tags": ["storyboard", "video"]
    }
  ]
}

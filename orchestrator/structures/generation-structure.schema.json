{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyos.dev/schemas/generation-structure-1.0.json",
  "title": "StoryOS Generation Structure",
  "type": "object",
  "required": ["structure_id", "version", "input", "output"],
  "properties": {
    "structure_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "parameters": {
      "description": "Optional editorial hints. Providers decide whether these hints are supported, how they are represented, and what limits apply.",
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "#/$defs/parameter"
        },
        "negative_prompt": {
          "$ref": "#/$defs/parameter"
        },
        "seed": {
          "$ref": "#/$defs/parameter"
        },
        "width": {
          "$ref": "#/$defs/parameter"
        },
        "height": {
          "$ref": "#/$defs/parameter"
        },
        "aspect_ratio": {
          "$ref": "#/$defs/parameter"
        },
        "duration_seconds": {
          "$ref": "#/$defs/parameter"
        },
        "frame_rate": {
          "$ref": "#/$defs/parameter"
        }
      },
      "additionalProperties": true
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "capability_requirements": {
      "description": "StoryOS-owned operation requirements such as generation and artifact delivery; provider-specific generation limits belong in capability descriptors.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_mapping": {
      "type": "object",
      "description": "Optional adapter-owned mapping metadata. This is not a provider API contract.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": ["modalities"],
      "properties": {
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["text", "image", "video", "audio", "mask", "3d"]
          }
        },
        "min_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_count": {
          "type": "integer",
          "minimum": 1
        },
        "mime_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["modalities"],
      "properties": {
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["image", "video", "audio", "text", "3d", "metadata"]
          }
        },
        "mime_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_target": {
          "enum": ["wordpress_media", "asset_collection", "external_storage"]
        }
      },
      "additionalProperties": true
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "integer", "number", "boolean", "object", "array"]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "enum": {
          "type": "array"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["role", "modalities"],
      "properties": {
        "role": {
          "enum": ["content", "style", "character", "pose", "start_frame", "end_frame", "audio", "mask"]
        },
        "modalities": {
          "type": "array",
          "items": {
            "enum": ["image", "video", "audio", "mask"]
          }
        },
        "max_count": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "name": "base",
  "description": "Base template with common defaults for all workflows",
  "placeholders": [
    "__POSITIVE_PROMPT__",
    "__NEGATIVE_PROMPT__",
    "__SEED__",
    "__STEPS__",
    "__CFG__",
    "__RESOLUTION_X__",
    "__RESOLUTION_Y__"
  ],
  "required_context_keys": ["positive_prompt"],
  "nodes": {
    "3": {
      "class_type": "EmptyLatentImage",
      "inputs": [
        {
          "width": "__RESOLUTION_X__",
          "height": "__RESOLUTION_Y__",
          "batch_size": "1"
        }
      ]
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "__POSITIVE_PROMPT__",
        "clip": ["3", 0]
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "__NEGATIVE_PROMPT__",
        "clip": ["3", 0]
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "__SEED__",
        "steps": "__STEPS__",
        "cfg": "__CFG__",
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": "1.0",
        "model": ["3", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["3", 0]
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["6", 0],
        "vae": ["3", 0]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "storyos",
        "images": ["7", 0]
      }
    }
  },
  "output": {
    "type": "image",
    "target": "wordpress_media"
  }
}

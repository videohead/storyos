{
  "name": "storyboard",
  "description": "Generate storyboard frames from scene descriptions",
  "placeholders": [
    "__SCENE_NUMBER__",
    "__SHOT_NUMBER__",
    "__POSITIVE_PROMPT__",
    "__NEGATIVE_PROMPT__",
    "__SEED__",
    "__STEPS__",
    "__CFG__",
    "__RESOLUTION_X__",
    "__RESOLUTION_Y__",
    "__SHOT_TYPE__"
  ],
  "required_context_keys": [
    "scene_number",
    "shot_number",
    "positive_prompt",
    "resolution_x",
    "resolution_y"
  ],
  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "__POSITIVE_PROMPT__",
        "clip": ["1", 1]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "__NEGATIVE_PROMPT__",
        "clip": ["1", 1]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "__RESOLUTION_X__",
        "height": "__RESOLUTION_Y__",
        "batch_size": "1"
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "__SEED__",
        "steps": "__STEPS__",
        "cfg": "__CFG__",
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": "1.0",
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 0]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "scene___SCENE_NUMBER__-shot___SHOT_NUMBER__",
        "images": ["6", 0]
      }
    }
  },
  "output": {
    "type": "image",
    "target": "wordpress_media",
    "post_type": "storyboard_frame"
  }
}

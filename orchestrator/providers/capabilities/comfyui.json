{
  "provider_type": "comfyui",
  "provider_version": "0.1.0",
  "capability_schema_version": "1.0",
  "discovery": {
    "mode": "workflow",
    "endpoint": "/object_info",
    "refresh_interval_seconds": 300,
    "notes": "ComfyUI capabilities depend on the connected instance, installed models, custom nodes, and selected workflow. Resolve concrete limits from the workflow and runtime node metadata before validation."
  },
  "operations": {
    "generate": true,
    "download_artifacts": true,
    "poll": true,
    "cancel": true
  },
  "models": [
    {
      "model_id": "workflow-defined",
      "status": "instance_defined",
      "execution_topology": {
        "mode": "comfy_native",
        "comfyui_required": true,
        "external_api_required": false,
        "dependencies": ["selected_workflow", "installed_models", "installed_nodes", "local_compute"]
      },
      "structures": [
        "text_to_image",
        "image_to_image",
        "text_to_video",
        "image_to_video",
        "video_to_video",
        "audio_generation",
        "3d_generation"
      ],
      "input_constraints": {
        "mime_types": ["image/*", "video/*", "audio/*"],
        "max_image_count": null,
        "max_video_count": null,
        "max_audio_inputs": null,
        "prompt_max_characters": null
      },
      "output_constraints": {
        "mime_types": ["image/*", "video/*", "audio/*", "model/gltf-binary", "model/obj"],
        "max_outputs_per_request": null
      },
      "dimensions": {
        "source": "workflow_node_inputs"
      },
      "video": {
        "source": "workflow_node_inputs"
      },
      "prompt": {
        "source": "workflow_node_inputs",
        "negative_prompt": "workflow_defined",
        "seed": "workflow_defined"
      },
      "references": {
        "source": "workflow_node_inputs"
      },
      "audio": {
        "source": "workflow_node_inputs"
      },
      "availability": {
        "source": "connection_runtime"
      }
    }
  ],
  "sources": [
    {
      "url": "https://docs.comfy.org/basic-concepts/models",
      "kind": "official_model",
      "retrieved_at": "2026-08-12"
    },
    {
      "url": "https://docs.comfy.org/interface/features/template",
      "kind": "official_workflow",
      "retrieved_at": "2026-08-12"
    }
  ]
}

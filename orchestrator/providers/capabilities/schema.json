{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyos.dev/schemas/provider-capability-descriptor-1.0.json",
  "title": "StoryOS Provider Capability Descriptor",
  "type": "object",
  "required": [
    "provider_type",
    "provider_version",
    "capability_schema_version",
    "discovery",
    "operations",
    "models"
  ],
  "properties": {
    "provider_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "capability_schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "discovery": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["static", "runtime", "connection", "workflow"]
        },
        "endpoint": {
          "type": ["string", "null"]
        },
        "refresh_interval_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "required": ["generate", "download_artifacts"],
      "properties": {
        "generate": {
          "type": "boolean"
        },
        "download_artifacts": {
          "type": "boolean"
        },
        "poll": {
          "type": "boolean"
        },
        "cancel": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "enum": ["official_api", "official_model", "official_workflow"]
          },
          "retrieved_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["model_id", "structures", "input_constraints", "output_constraints"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["stable", "preview", "deprecated", "instance_defined"]
        },
        "execution_topology": {
          "type": "object",
          "required": ["mode", "comfyui_required"],
          "properties": {
            "mode": {
              "enum": ["comfy_native", "comfy_partner", "external_adapter", "hybrid"]
            },
            "comfyui_required": {
              "type": "boolean"
            },
            "external_api_required": {
              "type": "boolean"
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "structures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_constraints": {
          "type": "object",
          "properties": {
            "mime_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_image_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "max_video_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "max_audio_inputs": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "prompt_max_characters": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "output_constraints": {
          "type": "object",
          "properties": {
            "mime_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_outputs_per_request": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": true
        },
        "aspect_ratios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": true
        },
        "prompt": {
          "type": "object",
          "additionalProperties": true
        },
        "references": {
          "type": "object",
          "additionalProperties": true
        },
        "audio": {
          "type": "object",
          "additionalProperties": true
        },
        "availability": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

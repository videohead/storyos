FROM vllm/vllm-openai:latest

RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl \
	&& rm -rf /var/lib/apt/lists/*

# Keep caches in a single mounted location so model downloads persist.
ENV HF_HOME=/models/cache/huggingface
ENV TRANSFORMERS_CACHE=/models/cache/huggingface
ENV HUGGINGFACE_HUB_CACHE=/models/cache/huggingface
ENV VLLM_CACHE_ROOT=/models/cache/vllm

# Optional but useful for private model access; pass at runtime when needed.
ENV HUGGING_FACE_HUB_TOKEN=

WORKDIR /workspace

COPY docker/entrypoint-with-log.sh /usr/local/bin/entrypoint-with-log.sh
RUN chmod +x /usr/local/bin/entrypoint-with-log.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-with-log.sh"]

# The base image already contains vLLM and the OpenAI-compatible API server entrypoint.
# Runtime command is defined in docker-compose.yaml to keep configuration in one place.
